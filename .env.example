# ============================================
# CONFIGURACIÓN DEL FRONTEND - VARIABLES DE ENTORNO
# ============================================
# Este archivo sirve como plantilla para las variables de entorno del frontend.
# Copia este archivo como .env y rellena los valores correctos.

# ============================================
# SUPABASE - CONEXIÓN DESDE EL CLIENTE (FRONTEND)
# ============================================
# URL de tu proyecto Supabase (la misma que en el backend)
# La encontrarás en: Configuración del Proyecto > API > Project URL
PUBLIC_SUPABASE_URL=tu_supabase_url_aqui

# ANON KEY - Esta es la clave pública/anónima de Supabase
# IMPORTANTE: Esta clave SÍ es segura para usar en el frontend
# La encontrarás en: Configuración del Proyecto > API > anon (public)
# NUNCA uses la service_role key en el frontend - esa es solo para el backend
PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# ============================================
# BACKEND API - URL DEL SERVIDOR
# ============================================
# URL del backend Flask
# En desarrollo: http://localhost:5000
# En producción: La URL de tu servidor desplegado
PUBLIC_API_URL=http://localhost:5000
