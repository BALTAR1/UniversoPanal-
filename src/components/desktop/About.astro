---
const stats = [
  { label: 'Ventas realizadas', value: '12.500+' },
  { label: 'Productos en catálogo', value: '2.300+' },
  { label: 'Atención 24hs', value: 'Sí' },
  { label: 'Clientes satisfechos', value: '98%' },
];

const valores = [
  { 
    titulo: 'Calidad',
    descripcion: 'Productos de primera línea con garantía',
    icono: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" /></svg>'
  },
  { 
    titulo: 'Confianza',
    descripcion: 'Miles de clientes satisfechos nos respaldan',
    icono: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>'
  },
  { 
    titulo: 'Innovación',
    descripcion: 'Siempre a la vanguardia tecnológica',
    icono: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" /></svg>'
  },
  { 
    titulo: 'Compromiso',
    descripcion: 'Con tu satisfacción y experiencia',
    icono: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" /></svg>'
  },
];
---

<section class="w-full bg-gradient-to-b from-white to-gray-50 py-10 mb-10">
  <div class="w-[85%] mx-auto">
    
    <!-- Encabezado principal -->
  <div class="text-center mb-12">
    <h1 class="text-4xl md:text-5xl text-blue-900 font-black mb-4">
        Sobre Nosotros
      </h1>
      <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
        Somos más que una tienda de electrónica, somos tu aliado tecnológico de confianza
      </p>
    </div>

    <!-- Contenido principal con imagen -->
  <div class="grid md:grid-cols-2 gap-12 items-center mb-16">
      <div>
  <img src="/images/image.png" alt="Electro Store" class="rounded-3xl w-3/4 max-w-md mx-auto object-cover animate-float" />
    </div>
      <style>
          @keyframes float {
            0% { transform: translateY(0); }
            50% { transform: translateY(18px); }
            100% { transform: translateY(0); }
          }
          .animate-float {
            animation: float 3s ease-in-out infinite;
          }
      </style>
      
      <div>
  <p class="text-lg text-black leading-relaxed mb-8">
          En <strong>Electro</strong>, nos apasiona acercar la mejor tecnología y productos para el hogar a miles de familias y empresas. Nos destacamos por ofrecer atención personalizada 24/7, un catálogo en constante crecimiento y una experiencia de compra ágil y segura.
        </p>
        
        <!-- Estadísticas -->
        <div class="grid grid-cols-2 gap-4">
          {stats.map(stat => (
            <div class="bg-white/90 rounded-xl p-5 text-center border-2 border-[#b9e3fe] shadow-md">
              <div class="text-3xl font-extrabold text-[#1a4e89] drop-shadow">{stat.value}</div>
              <div class="text-sm text-[#5ec6fa] mt-1 font-semibold">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Misión y Visión -->
  <div class="grid md:grid-cols-2 gap-6 mb-16">
      <!-- Misión -->
  <div class="bg-[#eaf6fd] rounded-2xl p-8 shadow-lg border-l-4 border-[#00bfff]">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 bg-[#b9e3fe] rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#00bfff]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-2xl font-black text-[#1a4e89]">Nuestra Misión</h3>
        </div>
  <p class="text-black text-lg leading-relaxed">
          Proporcionar productos tecnológicos de alta calidad con un servicio excepcional, facilitando el acceso a la innovación para mejorar la vida de nuestros clientes.
        </p>
      </div>

      <!-- Visión -->
  <div class="bg-[#eaf6fd] rounded-2xl p-8 shadow-lg border-l-4 border-[#5ec6fa]">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 bg-[#b9e3fe] rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#5ec6fa]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>
          <h3 class="text-2xl font-black text-[#1a4e89]">Nuestra Visión</h3>
        </div>
        <p class="text-black text-lg leading-relaxed">
          Ser la tienda de electrónica líder en el país, reconocida por nuestra excelencia en servicio, variedad de productos y compromiso con la satisfacción del cliente.
        </p>
      </div>
    </div>

    <!-- Valores -->
  <div class="text-center mb-12 mt-18">
      <h3 class="text-3xl md:text-4xl font-black text-gray-900 mb-3">Nuestros Valores</h3>
      <p class="text-lg text-black ">Los principios que nos guían cada día</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {valores.map((valor) => (
        <div class="bg-[#eaf6fd] rounded-2xl p-6 text-center hover:shadow-2xl transition-shadow duration-300 border border-[#b9e3fe]">
          <div class="w-16 h-16 mx-auto mb-4 text-[#00bfff]" set:html={valor.icono}></div>
          <h4 class="text-xl font-bold text-[#1a4e89] mb-2">{valor.titulo}</h4>
          <p class="text-black ">{valor.descripcion}</p>
        </div>
      ))}
    </div>

  </div>
</section>