---
// CTA + Footer Combined Component
import SocialMedias from '../ui/SocialMedias.jsx';
---

<!-- Sección combinada CTA + Footer que ocupa toda la pantalla -->
<section class="w-full min-h-screen flex flex-col bg-[#10279f]">
  
  <!-- CTA Section -->
  <div class="flex-1 flex items-center justify-center py-16 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl md:text-5xl font-black text-white mb-6">
        ¿Listo para comprar con nosotros?
      </h2>
      <p class="text-lg md:text-xl text-white/90 mb-10 max-w-2xl mx-auto">
        Contáctanos ahora y recibe atención personalizada. Estamos disponibles por WhatsApp o email.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <!-- WhatsApp Button -->
        <a 
          href="https://wa.me/5491112345678" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 px-8 py-4 bg-white text-[#2f5dff] rounded-full font-bold text-lg shadow-lg hover:bg-gray-100 transition-all hover:scale-105"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          WhatsApp
        </a>
        
        <!-- Email Button -->
        <a 
          href="mailto:contacto@electro.com" 
          class="inline-flex items-center gap-3 px-8 py-4 bg-white text-[#2f5dff] rounded-full font-bold text-lg shadow-lg hover:bg-gray-100 transition-all hover:scale-105"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Email
        </a>
      </div>
    </div>
  </div>

  <!-- Footer Section -->
  <footer class="bg-[#0a155c] text-white py-12 px-4 border-t border-white/10">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
        
        <!-- Columna 1: Logo y descripción -->
        <div>
          <h3 class="text-2xl font-black mb-3">Electro</h3>
          <p class="text-white/80 text-sm mb-4">
            Tu tienda de electrónica de confianza. Tecnología de calidad al mejor precio.
          </p>
        </div>

        <!-- Columna 2: Enlaces rápidos -->
        <div>
          <h4 class="text-lg font-bold mb-3">Enlaces Rápidos</h4>
          <ul class="space-y-2 text-white/80 text-sm">
            <li><a href="#" class="hover:text-white transition">Inicio</a></li>
            <li><a href="#" class="hover:text-white transition">Productos</a></li>
            <li><a href="#" class="hover:text-white transition">Servicios</a></li>
            <li><a href="#" class="hover:text-white transition">Sobre Nosotros</a></li>
          </ul>
        </div>

        <!-- Columna 3: Categorías -->
        <div>
          <h4 class="text-lg font-bold mb-3">Categorías</h4>
          <ul class="space-y-2 text-white/80 text-sm">
            <li><a href="#" class="hover:text-white transition">Electrónica</a></li>
            <li><a href="#" class="hover:text-white transition">Hogar</a></li>
            <li><a href="#" class="hover:text-white transition">Computadoras</a></li>
            <li><a href="#" class="hover:text-white transition">Ofertas</a></li>
          </ul>
        </div>

        <!-- Columna 4: Redes sociales -->
        <div>
          <h4 class="text-lg font-bold mb-6 text-center">Síguenos</h4>
          <SocialMedias client:load />
        </div>

      </div>

      <!-- Copyright -->
      <div class="border-t border-white/10 pt-6 text-center text-white/60 text-sm">
        <p>&copy; 2025 Electro. Todos los derechos reservados.</p>
      </div>
    </div>
  </footer>

</section>
