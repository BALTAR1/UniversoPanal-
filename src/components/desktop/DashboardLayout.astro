---
import Sidebar from '../ui/Sidebar.jsx';
import Layout from '../../layouts/Layout.astro';

const { title = "Bienvenido Admin!" } = Astro.props;
---

<Layout title={`${title} - Admin Dashboard`}>
    <div class="flex min-h-screen">
        <!-- Sidebar -->
        <Sidebar client:load />
        
        <!-- Main Content -->
        <main class="flex-1 w-full lg:w-auto p-4 md:p-8 bg-gray-100">
            <!-- Header con espacio para el botón hamburguesa en mobile -->
            <div class="mb-6 md:mb-8">
                <h1 class="text-2xl md:text-3xl font-bold text-gray-800 pr-12 lg:pr-0">{title}</h1>
                <p class="text-sm md:text-base text-gray-600 mt-2">Gestiona tu tienda desde aquí</p>
            </div>
            
            <!-- Content -->
            <div class="bg-white rounded-lg shadow-md p-4 md:p-6">
                <slot />
            </div>
        </main>
    </div>

    <script>
        // Verificar autenticación al cargar la página
        import { requireAuth } from '../../utils/auth.js';
        requireAuth();
    </script>
</Layout>
