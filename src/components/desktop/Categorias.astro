---

<!-- Contenedor que se superpone al Hero -->
<section class="relative -mt-16 md:-mt-24 z-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Tarjeta principal con fondo transparente -->
    <div class="relative bg-white/60 backdrop-blur-md
                rounded-3xl shadow-xl overflow-hidden border-2 border-white/80">
      
      <!-- Título -->
      <div class="text-center py-8 md:py-10">
        <h2 class="text-3xl md:text-4xl font-black text-blue-900">
          Categorías
        </h2>
      </div>

      <!-- Grid de Categorías -->
      <div class="px-6 pb-8 md:px-12 md:pb-12">
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 md:gap-4">
          {categorias.map((categoria) => (
            <a 
              href={`/categoria/${categoria.nombre.toLowerCase()}`}
              class="group bg-white/90 backdrop-blur-sm rounded-2xl p-4 md:p-6 
                     shadow-md hover:shadow-xl hover:bg-white
                     transition-all duration-300 hover:-translate-y-1 cursor-pointer
                     border-2 border-gray-100 hover:border-blue-300"
            >
              <div class="flex flex-col items-center text-center gap-2 md:gap-3">
                {/* Icono SVG */}
                <div class="w-10 h-10 md:w-12 md:h-12 text-gray-700 group-hover:text-blue-600 
                           transform group-hover:scale-110 transition-all duration-300"
                     set:html={categoria.svg}>
                </div>
                
                {/* Nombre */}
                <h3 class="text-sm md:text-base font-bold text-gray-900 group-hover:text-blue-600 transition-colors">
                  {categoria.nombre}
                </h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
