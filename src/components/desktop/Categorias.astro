---
// Categorías principales con imágenes
const categorias = [
  { id: 1, nombre: 'Pañales', imagen: '/images/CatPanal.png' },
  { id: 2, nombre: 'Nutrición', imagen: '/images/CatNutricion.png' },
  { id: 3, nombre: 'Higiene', imagen: '/images/CatHigiene.png' },
  { id: 4, nombre: 'Adultos', imagen: '/images/CatAdultos.png' },
  { id: 5, nombre: 'Accesorios', imagen: '/images/CatAccesorios.png' },
  { id: 6, nombre: 'Toallitas humedas', imagen: '/images/CatToallitas.png' },
  { id: 7, nombre: 'Mama', imagen: '/images/CatMama.png' },
  { id: 8, nombre: 'Ofertas', imagen: '/images/CatOferta.jpg' },
];
---

<!-- Contenedor que se superpone al Hero -->
<section class="relative -mt-8 md:-mt-12 z-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Tarjeta principal con fondo transparente -->
  <div class="relative bg-white rounded-t-3xl rounded-b-[2.5rem] shadow-2xl overflow-hidden mb-8">
      
      <!-- Título -->
        <div class="text-center py-8 md:py-10">
        <h2 class="text-6xl md:text-4xl font-black text-cyan-600">
          Categorías
        </h2>
      </div>

      <!-- Grid de Categorías -->
      <div class="px-6 pb-8 md:px-12 md:pb-12">
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
            {categorias.map((categoria) => (
              <a 
                href={`/categoria/${categoria.nombre.toLowerCase().replace(/\s+/g, '-')}`}
                class={`group bg-white/90 backdrop-blur-sm rounded-2xl p-4 md:p-6 
                  shadow-md hover:shadow-xl hover:bg-white
                  transition-all duration-300 hover:-translate-y-1 cursor-pointer
                  border-2 border-gray-100 hover:border-orange-300`}
              >
                <div class="flex flex-col items-center text-center gap-2 md:gap-3 h-full w-full">
                  <div class="relative w-full h-24 md:h-32 flex items-end justify-center">
                    <div class="w-full h-full rounded-xl bg-cover bg-center"
                      style={`background-image: url('${categoria.imagen}')`}>
                    </div>
                    <h3 class="absolute bottom-2 left-1/2 -translate-x-1/2 px-2 py-1 rounded-lg font-bold w-max border border-orange-200 shadow text-white text-sm md:text-base transition-all duration-200 bg-orange-500 hover:scale-105 hover:shadow-2xl hover:bg-orange-600 whitespace-nowrap">
                      {categoria.nombre}
                    </h3>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
