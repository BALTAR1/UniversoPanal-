---
// Categorías principales con iconos SVG
const categorias = [
  { id: 1, nombre: 'Pañales', svg: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7.5V6a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v1.5M3 7.5v9A3 3 0 0 0 6 19.5h12a3 3 0 0 0 3-3v-9M3 7.5h18" /></svg>' },
  { id: 2, nombre: 'Nutrición', svg: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18m6-6H6" /></svg>' },
  { id: 3, nombre: 'Higiene', svg: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18m6-6H6" /></svg>' },
  { id: 4, nombre: 'Adultos', svg: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><circle cx="12" cy="8" r="4" /><path stroke-linecap="round" stroke-linejoin="round" d="M6 20v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2" /></svg>' },
  { id: 5, nombre: 'Accesorios', svg: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><rect x="4" y="4" width="16" height="16" rx="4"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h8" /></svg>' },
  { id: 6, nombre: 'Ofertas', svg: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2v20m10-10H2" /><circle cx="12" cy="12" r="4" /></svg>' },
];
---

<!-- Contenedor que se superpone al Hero -->
<section class="relative -mt-8 md:-mt-12 z-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Tarjeta principal con fondo transparente -->
  <div class="relative bg-white rounded-t-3xl rounded-b-[2.5rem] shadow-2xl overflow-hidden mb-8">
      
      <!-- Título -->
        <div class="text-center py-8 md:py-10">
        <h2 class="text-6xl md:text-4xl font-black text-cyan-600">
          Categorías
        </h2>
      </div>

      <!-- Carrusel de Categorías -->
      <style>
        .carrusel-categorias::-webkit-scrollbar {
          height: 8px;
        }
        .carrusel-categorias::-webkit-scrollbar-thumb {
          background: #c7c7c7;
          border-radius: 4px;
        }
        .carrusel-categorias {
          scroll-behavior: smooth;
        }
        .carrusel-btn {
          background: #fff;
          border: 2px solid #ff792b;
          color: #ff792b;
          border-radius: 50%;
          width: 2.5rem;
          height: 2.5rem;
          display: flex;
          align-items: center;
          justify-content: center;
          box-shadow: 0 2px 8px rgba(0,0,0,0.08);
          transition: background 0.2s, color 0.2s;
        }
        .carrusel-btn:hover {
          background: rgb(19, 127, 177);
          color: #fff;
        }
      </style>
      <div class="px-6 pb-8 md:px-12 md:pb-12">
        <div class="relative">
          <button class="carrusel-btn absolute left-0 top-1/2 -translate-y-1/2 z-10" onclick="document.getElementById('carrusel-categorias').scrollBy({left: -320, behavior: 'smooth'})" aria-label="Anterior">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7"/></svg>
          </button>
          <div id="carrusel-categorias" class="carrusel-categorias flex gap-4 overflow-x-auto px-8 py-2 scroll-smooth snap-x snap-mandatory">
            {categorias.map((categoria) => (
              <a 
                href={`/categoria/${categoria.nombre.toLowerCase()}`}
                class={`group bg-white/90 backdrop-blur-sm rounded-2xl p-4 md:p-6 
                  shadow-md hover:shadow-xl hover:bg-white
                  transition-all duration-300 hover:-translate-y-1 cursor-pointer
                  border-2 border-gray-100 hover:border-orange-300 w-64 min-w-[16rem] max-w-xs snap-center`}
              >
                <div class="flex flex-col items-center text-center gap-2 md:gap-3 h-full w-full">
                  <div class="relative w-full h-24 md:h-32 flex items-end justify-center">
                    <div class="w-full h-full rounded-xl bg-cover bg-center"
                      style={categoria.nombre === 'Nutrición' ? `background-image: url('/images/CatNutricion.png')` : categoria.nombre === 'Pañales' ? `background-image: url('/images/CatPanal.png')` : categoria.nombre === 'Higiene' ? `background-image: url('/images/CatHigiene.png')` : categoria.nombre === 'Adultos' ? `background-image: url('/images/CatAdultos.png')` : categoria.nombre === 'Accesorios' ? `background-image: url('/images/CatAccesorios.png')` : categoria.nombre === 'Ofertas' ? `background-image: url('/images/CatOferta.jpg')` : ''}>
                    </div>
                    <h3 class="absolute bottom-2 left-1/2 -translate-x-1/2 px-2 py-1 rounded-lg font-bold w-max border border-orange-200 shadow text-white text-sm md:text-base transition-all duration-200 bg-orange-500 hover:scale-105 hover:shadow-2xl hover:bg-orange-600">
                      {categoria.nombre}
                    </h3>
                  </div>
                </div>
              </a>
            ))}
          </div>
          <button class="carrusel-btn absolute right-0 top-1/2 -translate-y-1/2 z-10" onclick="document.getElementById('carrusel-categorias').scrollBy({left: 320, behavior: 'smooth'})" aria-label="Siguiente">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
