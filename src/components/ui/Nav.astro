---
import CartIcon from './CartIcon.jsx';
---

<nav class="bg-white shadow-md">
    <div class="container mx-auto px-6 py-3">
        <div class="flex items-center justify-between">
            <div class="text-2xl font-bold text-amber-500">
                <a href="/">Universo Pañal</a>
            </div>
            <div class="hidden items-center space-x-6 md:flex">
                <a href="/productos" class="relative group text-gray-800 hover:text-blue-600">
                    <span>Productos</span>
                    <span class="absolute bottom-0 left-0 h-0.5 w-full scale-x-0 transform bg-blue-600 transition-transform duration-300 ease-in-out group-hover:scale-x-100"></span>
                </a>
                <a href="/nosotros" class="relative group text-gray-800 hover:text-blue-600">
                    <span>Nosotros</span>
                    <span class="absolute bottom-0 left-0 h-0.5 w-full scale-x-0 transform bg-blue-600 transition-transform duration-300 ease-in-out group-hover:scale-x-100"></span>
                </a>
                <a href="/servicios" class="relative group text-gray-800 hover:text-blue-600">
                    <span>Servicios</span>
                    <span class="absolute bottom-0 left-0 h-0.5 w-full scale-x-0 transform bg-blue-600 transition-transform duration-300 ease-in-out group-hover:scale-x-100"></span>
                </a>
                <a href="/servicios" class="relative group text-gray-800 hover:text-blue-600">
                    <span>Mayorista</span>
                    <span class="absolute bottom-0 left-0 h-0.5 w-full scale-x-0 transform bg-blue-600 transition-transform duration-300 ease-in-out group-hover:scale-x-100"></span>
                </a>
            </div>
            <div class="flex items-center gap-8">
                <CartIcon client:load />
                <a href="/contacto" class="rounded-md bg-amber-500 px-4 py-2 text-white transition-colors duration-300 hover:bg-blue-700">
                    Contacto
                </a>
            </div>
        </div>
    </div>
</nav>
