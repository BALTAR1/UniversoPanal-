---
// Marcas Mobile - Carrusel horizontal simple
const marcas = [
  { id: 1, nombre: 'Babysec', imagen: '/images/marcas/Babysec.png' },
  { id: 2, nombre: 'Huggies', imagen: '/images/marcas/Huggies.png' },
  { id: 3, nombre: 'Nido', imagen: '/images/marcas/Nido.png' },
  { id: 4, nombre: 'Nutricia', imagen: '/images/marcas/Nutricia.png' },
  { id: 5, nombre: 'Pampers', imagen: '/images/marcas/Pampers.png' },
  { id: 6, nombre: 'Vital', imagen: '/images/marcas/Vital.png' },
  { id: 7, nombre: 'Duffy', imagen: '/images/marcas/Duffy.png' },
  { id: 8, nombre: 'Dispita', imagen: '/images/marcas/Dispita.png' },
  { id: 9, nombre: 'Comodin', imagen: '/images/marcas/Comodin.png' },
  { id: 10, nombre: 'Nestle', imagen: '/images/marcas/Nestle.png' }
];
---

<section class="w-full py-8 bg-gray-50">
  <div class="px-4">
    <h2 class="text-2xl font-black text-cyan-600 text-center mb-6">
      Marcas de Confianza
    </h2>
    
    <div class="overflow-x-auto pb-4 hide-scrollbar">
      <div class="flex gap-6 justify-center items-center pl-26">
        {marcas.map((marca) => (
          <div class="flex-shrink-0 w-24 h-24 bg-white rounded-lg shadow-md flex items-center justify-center p-3 hover:shadow-lg transition-shadow">
              <img 
                src={marca.imagen} 
                alt={marca.nombre}
                class="w-full h-full object-contain"
              />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.hide-scrollbar::-webkit-scrollbar {
  display: none;
}
.hide-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}
</style>
