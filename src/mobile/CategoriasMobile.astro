---
/**
 * CategoriasMobile Component
 * 
 * Carrusel horizontal de categorías optimizado para dispositivos móviles.
 * Muestra 8 categorías principales del e-commerce con scroll horizontal.
 * 
 * Características:
 * - Scroll horizontal suave con snap para mejor UX en táctil
 * - Tarjetas de ancho fijo (128px) para mantener simetría
 * - Alto fijo del texto (h-12) para evitar diferencias de altura
 * - Oculta scrollbar para apariencia limpia
 * - Redirección a páginas de categoría con slugs URL-friendly
 * 
 * Notas:
 * - Las categorías deben existir en el backend para mostrar productos
 * - Si una categoría no existe, la página mostrará lista vacía (no error)
 * - Los slugs se generan automáticamente (ej: "Toallitas Húmedas" → "toallitas-húmedas")
 */

const categorias = [
  { id: 1, nombre: 'Pañales', imagen: '/images/CatPanal.png' },
  { id: 2, nombre: 'Nutrición', imagen: '/images/CatNutricion.png' },
  { id: 3, nombre: 'Higiene', imagen: '/images/CatHigiene.png' },
  { id: 4, nombre: 'Adultos', imagen: '/images/CatAdultos.png' },
  { id: 5, nombre: 'Accesorios', imagen: '/images/CatAccesorios.png' },
  { id: 6, nombre: 'Toallitas humedas', imagen: '/images/CatHigiene.png' },
  { id: 7, nombre: 'Mama', imagen: '/images/CatAccesorios.png' },
  { id: 8, nombre: 'Ofertas', imagen: '/images/CatOferta.jpg' },
];
---

<section class="w-full py-8 bg-white">
  <div class="px-4">
    <!-- Título de la sección -->
    <h2 class="text-2xl font-black text-cyan-600 text-center mb-6">
      Categorías
    </h2>
    
    <!-- Carrusel horizontal con scroll oculto -->
    <div class="overflow-x-auto pb-4 hide-scrollbar">
      <div class="flex gap-4 px-2">
        {categorias.map((categoria) => (
          <a 
            href={`/categoria/${categoria.nombre.toLowerCase().replace(/\s+/g, '-')}`}
            class="flex-shrink-0 w-32"
          >
            {/* Tarjeta de categoría con dimensiones fijas */}
            <div class="bg-white rounded-xl shadow-md hover:shadow-lg transition-all overflow-hidden border border-gray-100">
              {/* Contenedor de imagen con altura fija */}
              <div class="relative h-32 bg-gray-50">
                <img 
                  src={categoria.imagen} 
                  alt={categoria.nombre}
                  class="w-full h-full object-cover"
                />
              </div>
              {/* Contenedor de texto con altura fija para mantener simetría */}
              <div class="p-2 h-12 flex items-center justify-center">
                <p class="text-sm font-bold text-[#ff792b] text-center line-clamp-2">
                  {categoria.nombre}
                </p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.hide-scrollbar::-webkit-scrollbar {
  display: none;
}
.hide-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}
</style>
