---
// Hero Mobile - Versión optimizada para móviles
---

<section class="relative w-full h-[60vh] min-h-[400px] bg-gradient-to-br from-blue-100 via-cyan-50 to-blue-50 overflow-hidden">
  {/* Decoraciones de fondo móvil */}
  <div class="absolute inset-0 overflow-hidden">
    <svg class="absolute top-10 left-0 w-32 h-32 opacity-20" viewBox="0 0 200 200" fill="none">
      <circle cx="100" cy="100" r="80" fill="#60a5fa"/>
    </svg>
    <svg class="absolute bottom-10 right-0 w-40 h-40 opacity-20" viewBox="0 0 200 200" fill="none">
      <circle cx="100" cy="100" r="80" fill="#34d399"/>
    </svg>
  </div>

  {/* Contenido principal */}
  <div class="relative z-10 flex flex-col items-center justify-center h-full px-4 text-center">
    <img 
      src="/images/logo.jpg" 
      alt="Logo Universo Pañal" 
      class="w-24 h-24 rounded-full border-4 border-white shadow-lg mb-4 object-cover"
    />
    <h1 class="text-3xl font-black text-[#ff792b] mb-2">
      Universo Pañal
    </h1>
    <p class="text-base text-gray-700 mb-6 max-w-xs">
      Tu tienda de confianza para el cuidado de tu bebé
    </p>
    <div class="flex flex-col gap-3 w-full max-w-xs">
      <a 
        href="/productos" 
        class="px-6 py-3 bg-[#ff792b] text-white font-bold rounded-full shadow-lg hover:bg-orange-600 transition-all text-center"
      >
        Ver productos
      </a>
      <a 
        href="/combos" 
        class="px-6 py-3 bg-cyan-600 text-white font-bold rounded-full shadow-lg hover:bg-cyan-700 transition-all text-center"
      >
        Ver combos
      </a>
    </div>
  </div>
</section>
