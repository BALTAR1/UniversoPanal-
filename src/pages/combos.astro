---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import Nav from '../components/ui/Nav.astro';
import Hero from '../components/desktop/Hero.astro';
import Footer from '../components/desktop/Footer.astro';
import CatalogoCombos from '../components/combos/CatalogoCombos.jsx';
---

<Layout title="Combos - Mundo Pañal">
    <!-- Navegación -->
    <Nav />
    
    <!-- Hero Section -->
    <Hero />
    
    <!-- Catálogo de Combos -->
    <section class="bg-gray-50 py-12">
        <CatalogoCombos client:only="react" />
    </section>
    
    <!-- Footer -->
    <Footer />
</Layout>

<style>
    /* Estilos adicionales para la página de combos */
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>
