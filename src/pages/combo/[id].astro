---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/ui/Nav.astro';
import NavMobile from '../../mobile/NavMobile.astro';
import MenuBurger from '../../mobile/MenuBurger.astro';
import Footer from '../../components/ui/Footer.astro';
import DetalleCombo from '../../components/combos/DetalleCombo.jsx';
import { supabase } from '../../lib/supabaseCliente.js';

// Pre-renderizar todas las páginas de combos
export const prerender = true;

// Generar rutas estáticas para todos los combos
export async function getStaticPaths() {
    const { data: combos } = await supabase
        .from('combos')
        .select('combo_id')
        .eq('activo', true);
    
    return combos?.map(combo => ({
        params: { id: combo.combo_id.toString() }
    })) || [];
}

// Obtener el ID del combo de la URL
const { id } = Astro.params;
---

<Layout title="Detalle del Combo - Mundo Pañal">
    {/* Nav Desktop */}
    <div class="hidden md:block">
        <Nav />
    </div>
    
    {/* Nav Mobile */}
    <div class="block md:hidden">
        <NavMobile />
    </div>
    
    <MenuBurger />
    
    <main class="min-h-screen bg-gray-50 py-8">
        <DetalleCombo client:only="react" comboId={id} />
    </main>

    <Footer />
</Layout>
