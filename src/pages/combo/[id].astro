---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/ui/Nav.astro';
import Footer from '../../components/ui/Footer.astro';
import DetalleCombo from '../../components/combos/DetalleCombo.jsx';

// Hacer que esta página sea renderizada del lado del servidor (SSR)
export const prerender = false;

// Obtener el ID del combo de la URL
const { id } = Astro.params;
---

<Layout title="Detalle del Combo - Mundo Pañal">
    <Nav />
    
    <main class="min-h-screen bg-gray-50 py-8">
        <DetalleCombo client:only="react" comboId={id} />
    </main>

    <Footer />
</Layout>
