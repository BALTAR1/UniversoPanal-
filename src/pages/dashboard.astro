---
import Layout from '../layouts/Layout.astro';
import DashboardLayout from '../components/desktop/DashboardLayout.astro';
import '../styles/global.css';
---

<Layout>
	<DashboardLayout>
		<div class="p-2 md:p-6">
			<h1 class="text-2xl md:text-3xl font-bold text-gray-800 mb-4 md:mb-6">
				Panel de Administración
			</h1>
			
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
				<!-- Card: Productos -->
				<div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow p-4 md:p-6">
					<div class="flex items-center justify-between mb-3 md:mb-4">
						<h2 class="text-lg md:text-xl font-semibold text-gray-700">Productos</h2>
						<svg class="w-6 h-6 md:w-8 md:h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
						</svg>
					</div>
					<p class="text-sm md:text-base text-gray-600 mb-3 md:mb-4">Gestiona el catálogo de productos</p>
					<a 
						href="/dashboard/productos" 
						class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded transition-colors text-sm md:text-base"
					>
						Ver Productos
					</a>
				</div>

				<!-- Card: Categorías -->
				<div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow p-4 md:p-6">
					<div class="flex items-center justify-between mb-3 md:mb-4">
						<h2 class="text-lg md:text-xl font-semibold text-gray-700">Categorías</h2>
						<svg class="w-6 h-6 md:w-8 md:h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
						</svg>
					</div>
					<p class="text-sm md:text-base text-gray-600 mb-3 md:mb-4">Organiza tus productos en categorías</p>
					<a 
						href="/dashboard/categorias" 
						class="inline-block bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-4 rounded transition-colors text-sm md:text-base"
					>
						Ver Categorías
					</a>
				</div>
			</div>

			<!-- Información adicional -->
			<div class="mt-6 md:mt-8 bg-blue-50 border-l-4 border-blue-600 p-3 md:p-4 rounded">
				<div class="flex items-start">
					<svg class="w-5 h-5 md:w-6 md:h-6 text-blue-600 mr-2 md:mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
					</svg>
					<div>
						<h3 class="text-base md:text-lg font-semibold text-blue-800 mb-1">Bienvenido al Panel de Administración</h3>
						<p class="text-sm md:text-base text-blue-700">
							Desde aquí puedes gestionar todos los aspectos de tu catálogo de productos. 
							Usa el menú lateral para navegar entre las diferentes secciones.
						</p>
					</div>
				</div>
			</div>
		</div>
	</DashboardLayout>
</Layout>

<style>
	/* Animación para las cards */
	.grid > div {
		animation: fadeInUp 0.5s ease-out;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>

<script>
	// Verificar autenticación del usuario
	import { supabase } from '../lib/supabaseCliente.js';

	async function checkAuth() {
		const { data: { session }, error } = await supabase.auth.getSession();
		
		if (error) {
			console.error('Error al verificar sesión:', error);
			window.location.href = '/login';
			return;
		}

		if (!session) {
			console.log('No hay sesión activa, redirigiendo a login...');
			window.location.href = '/login';
			return;
		}

		console.log('✅ Usuario autenticado:', session.user.email);
	}

	// Ejecutar verificación al cargar la página
	checkAuth();
</script>
