---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import LoginForm from '../components/auth/loginform.jsx';
---

<Layout>
	<main class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 via-white to-blue-100 px-4 py-8">
		<div class="w-full max-w-md">
			<!-- Logo o título -->
			<div class="text-center mb-8">
				<h1 class="text-3xl sm:text-4xl font-bold text-gray-800 mb-2">
					Mundo Pañal
				</h1>
				<p class="text-gray-600">
					Inicia sesión para acceder al panel de administración
				</p>
			</div>

			<!-- Formulario de login -->
			<LoginForm client:load />

			<!-- Link para volver al inicio -->
			<div class="text-center mt-6">
				<a 
					href="/" 
					class="text-blue-600 hover:text-blue-700 transition-colors text-sm font-medium"
				>
					← Volver al inicio
				</a>
			</div>
		</div>
	</main>
</Layout>

<style>
	main {
		position: relative;
		overflow: hidden;
	}

	/* Efecto de fondo animado opcional */
	main::before {
		content: '';
		position: absolute;
		width: 500px;
		height: 500px;
		background: radial-gradient(circle, rgba(59, 130, 246, 0.1) 0%, transparent 70%);
		top: -250px;
		right: -250px;
		border-radius: 50%;
		animation: float 20s ease-in-out infinite;
	}

	main::after {
		content: '';
		position: absolute;
		width: 400px;
		height: 400px;
		background: radial-gradient(circle, rgba(147, 197, 253, 0.1) 0%, transparent 70%);
		bottom: -200px;
		left: -200px;
		border-radius: 50%;
		animation: float 15s ease-in-out infinite reverse;
	}

	@keyframes float {
		0%, 100% {
			transform: translate(0, 0) scale(1);
		}
		33% {
			transform: translate(30px, -30px) scale(1.1);
		}
		66% {
			transform: translate(-20px, 20px) scale(0.9);
		}
	}
</style>
