---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import LoginForm from '../components/auth/loginform.jsx';
---

<Layout>
	<main class="min-h-screen flex items-center justify-center bg-gradient-to-br from-[#e0f2fe] via-white to-[#f7b6d2] px-4 py-8 relative">
		<div class="w-full max-w-md mx-auto">
			<div class="glass-card shadow-2xl rounded-3xl px-6 py-10 sm:p-12 flex flex-col items-center relative">
				<!-- Logo grande -->
						<div class="flex flex-col items-center mb-6">
							<div class="bg-gradient-to-tr from-[#7be3f7] via-[#f7b6d2] to-[#e0f2fe] rounded-full p-2 shadow-lg mb-2">
								<img src="/images/Universo pañal 2.png" alt="Logo Universo Pañal" class="w-28 h-28 rounded-full object-cover bg-white p-1 shadow-md" loading="lazy" />
							</div>
					<h1 class="text-4xl font-extrabold text-gray-800 tracking-tight mb-1 drop-shadow-sm">Universo Pañal</h1>
					<p class="text-base text-gray-500 font-medium">Inicia sesión para acceder al panel</p>
				</div>
				<!-- Formulario de login -->
				<LoginForm client:load />
				<!-- Link para volver al inicio -->
						<div class="text-center mt-8">
							  <a href="/" class="inline-block text-base font-bold px-6 py-2 rounded-full shadow-lg bg-[#2563eb] text-white ring-2 ring-[#2563eb]/30 hover:scale-105 hover:shadow-xl transition-all duration-200">← Volver al inicio</a>
						</div>
				<!-- Footer pequeño -->
				<div class="mt-8 text-xs text-gray-400 text-center w-full opacity-80">
					&copy; {new Date().getFullYear()} Universo Pañal. Todos los derechos reservados.
				</div>
			</div>
		</div>
		<!-- Burbujas decorativas -->
		<div class="absolute top-0 left-0 w-60 h-60 bg-[#7be3f7]/30 rounded-full blur-3xl opacity-60 animate-float-slow -z-10"></div>
		<div class="absolute bottom-0 right-0 w-72 h-72 bg-[#f7b6d2]/30 rounded-full blur-3xl opacity-60 animate-float-slow2 -z-10"></div>
	</main>
</Layout>

<style>
	.glass-card {
		background: rgba(255,255,255,0.85);
		box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.10);
		backdrop-filter: blur(8px);
		border: 1.5px solid rgba(255,255,255,0.25);
	}
	.animate-float-slow {
		animation: float 18s ease-in-out infinite;
	}
	.animate-float-slow2 {
		animation: float2 22s ease-in-out infinite;
	}
	@keyframes float {
		0%, 100% { transform: translate(0, 0) scale(1); }
		33% { transform: translate(30px, -30px) scale(1.08); }
		66% { transform: translate(-20px, 20px) scale(0.95); }
	}
	@keyframes float2 {
		0%, 100% { transform: translate(0, 0) scale(1); }
		40% { transform: translate(-40px, 30px) scale(1.1); }
		80% { transform: translate(20px, -20px) scale(0.92); }
	}
</style>
