---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import Nav from '../components/ui/Nav.astro';
import Hero from '../components/desktop/Hero.astro';
import Footer from '../components/desktop/Footer.astro';
import CatalogoProductos from '../components/productos/CatalogoProductos.jsx';
---

<Layout title="Productos - Mundo Pañal">
    <!-- Navegación -->
    <Nav />
    
    <!-- Hero Section -->
    <Hero />
    
    <!-- Catálogo de Productos -->
    <section class="bg-gray-50 py-12">
        <CatalogoProductos client:only="react" />
    </section>
    
</Layout>

<style>
    /* Estilos adicionales para la página de productos */
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>
