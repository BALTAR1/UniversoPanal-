---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/ui/Nav.astro';
import Footer from '../../components/ui/Footer.astro';
import DetalleProducto from '../../components/productos/DetalleProducto.jsx';

// Hacer que esta página sea renderizada del lado del servidor (SSR)
export const prerender = false;

// Obtener el ID del producto de la URL
const { id } = Astro.params;
---

<Layout title="Detalle del Producto - Mundo Pañal">
    <Nav />
    
    <main class="min-h-screen bg-gray-50 py-8">
        <DetalleProducto client:only="react" productoId={id} />
    </main>

    <Footer />
</Layout>
